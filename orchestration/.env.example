# Copy to .env and set the existing ADC JSON path. Never paste its contents.
GCP_ADC_PATH=C:/Users/User/AppData/Roaming/gcloud/application_default_credentials.json
# Host port for the Airflow UI (bound to 127.0.0.1 only).
AIRFLOW_PORT=8081
# Postgres 與 Airflow 登入密碼都固定為 admin，寫在 compose.yml（僅限本機自用）。
